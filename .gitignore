# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#

# LuaProject is the actual Unity project
LuaProject/.utmp/
LuaProject/[Ll]ibrary/
LuaProject/[Tt]emp/
LuaProject/[Oo]bj/
LuaProject/[Bb]uild/
LuaProject/[Bb]uilds/
LuaProject/[Ll]ogs/
LuaProject/[Uu]ser[Ss]ettings/
LuaProject/*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
LuaProject/*.blend1
LuaProject/*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
LuaProject/[Mm]emoryCaptures/

# Recordings can get excessive in size
LuaProject/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# LuaProject/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
LuaProject/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
LuaProject/*.DotSettings.user

# Visual Studio cache directory
LuaProject/.vs/

# Gradle cache directory
LuaProject/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
LuaProject/ExportedObj/
LuaProject/.consulo/
LuaProject/*.csproj
LuaProject/*.unityproj
LuaProject/*.sln
LuaProject/*.suo
LuaProject/*.tmp
LuaProject/*.user
LuaProject/*.userprefs
LuaProject/*.pidb
LuaProject/*.booproj
LuaProject/*.svd
LuaProject/*.pdb
LuaProject/*.mdb
LuaProject/*.opendb
LuaProject/*.VC.db

# Unity3D generated meta files
LuaProject/*.pidb.meta
LuaProject/*.pdb.meta
LuaProject/*.mdb.meta

# Unity3D generated file on crash reports
LuaProject/sysinfo.txt

# Mono auto generated files
LuaProject/mono_crash.*

# Builds
LuaProject/*.apk
LuaProject/*.aab
LuaProject/*.unitypackage
LuaProject/*.unitypackage.meta
LuaProject/*.app

# Crashlytics generated file
LuaProject/crashlytics-build.properties

# TestRunner generated files
LuaProject/InitTestScene*.unity*

# Addressables default ignores, before user customizations
LuaProject/ServerData
LuaProject/[Aa]ssets/StreamingAssets/aa*
LuaProject/[Aa]ssets/AddressableAssetsData/link.xml*
LuaProject/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
LuaProject/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
LuaProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
LuaProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
LuaProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
LuaProject/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
LuaProject/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
